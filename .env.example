# ──────────────────────────────────────────────
# KopaDot AI E-Commerce Support Agent
# ──────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
API_SECRET_KEY=replace-with-a-strong-random-secret

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback model (set only if supported in your account/region)
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# BaseLinker
BASELINKER_API_TOKEN=your-baselinker-api-token
# Optional but recommended for inventory product tools
# BASELINKER_INVENTORY_ID=12345

# Zendesk
ZENDESK_SUBDOMAIN=your-zendesk-subdomain
ZENDESK_API_TOKEN=your-zendesk-api-token
ZENDESK_EMAIL=your-zendesk-admin-email

# Store Configuration
STORE_NAME=KopaDot
STORE_CURRENCY=EUR
STORE_TIMEZONE=Europe/Dublin

# Session
SESSION_TTL_MINUTES=120
MAX_CONVERSATION_HISTORY=20

# Safety
MAX_TOOL_CALLS_PER_TURN=10
CONFIDENCE_THRESHOLD=0.7

# Microsoft 365 / Graph API
MS_GRAPH_TENANT_ID=your-tenant-id
MS_GRAPH_CLIENT_ID=your-client-id
MS_GRAPH_CLIENT_SECRET=your-client-secret
MS_GRAPH_USER_ID=support@yourdomain.com

EMAIL_POLLING_ENABLED=true
EMAIL_POLL_INTERVAL_MS=180000

EMAIL_PRIORITY_HOURS=6
EMAIL_LOOKBACK_HOURS=6
EMAIL_MAX_PER_POLL=20

EMAIL_ESCALATED_FOLDER_NAME=Escalated
EMAIL_AGENT_SIGNOFF_NAME=KopaDot Support Team
